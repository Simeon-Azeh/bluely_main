rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsNewDocument() {
      return signedIn() && request.resource.data.firebaseUid == request.auth.uid;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.firebaseUid == request.auth.uid;
    }

    match /users/{documentId} {
      allow read: if ownsExistingDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsExistingDocument() && request.resource.data.firebaseUid == request.auth.uid;
      allow delete: if ownsExistingDocument();
    }

    match /storySubmissions/{documentId} {
      // Stories are accepted through the server API, which uses Admin SDK credentials.
      allow read, write: if false;
    }

    match /{collection}/{documentId} {
      allow read: if ownsExistingDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsExistingDocument() && request.resource.data.firebaseUid == request.auth.uid;
      allow delete: if ownsExistingDocument();
    }
  }
}
